<?xml version="1.0" encoding="utf-8" ?>
<views:BaseView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ShoppingApp.Views"
    x:Class="ShoppingApp.Views.ProductDetailsView"
    Title="Product Details"
    BackgroundColor="#F7E8CF">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="18">

            <!-- Tadka Branding -->
            <VerticalStackLayout Spacing="2">
                <Label Text="✦ Tadka ✦"
                       FontFamily="JainiRegular"
                       FontSize="42"
                       TextColor="#8B302D"
                       HorizontalOptions="Center" />

                <Label Text="A taste of home, in every spice."
                       FontSize="13"
                       TextColor="#A65E3F"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Product Information Card -->
            <Border BackgroundColor="#FFF9F0"
                    Stroke="#D98245"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="18">

                <VerticalStackLayout Spacing="15">

                    <Image Source="{Binding SelectedProduct.ImageName}"
                           HeightRequest="230"
                           Aspect="AspectFit"
                           HorizontalOptions="Center" />

                    <Label Text="{Binding SelectedProduct.ProductName}"
                           FontSize="27"
                           FontAttributes="Bold"
                           TextColor="#8B302D"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />

                    <Label Text="{Binding SelectedProduct.CategoryName}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#A65E3F"
                           HorizontalOptions="Center" />

                    <Label Text="{Binding SelectedProduct.ProductDescription}"
                           FontSize="15"
                           TextColor="#655044"
                           HorizontalTextAlignment="Center" />

                    <Label Text="{Binding SelectedProduct.ProductPrice,
                                          StringFormat='R{0:F2}'}"
                           FontSize="25"
                           FontAttributes="Bold"
                           TextColor="#8B302D"
                           HorizontalOptions="Center" />

                    <Label Text="{Binding SelectedProduct.StockAvailable,
                                          StringFormat='Available stock: {0}'}"
                           FontSize="14"
                           TextColor="#65734A"
                           HorizontalOptions="Center" />

                    <BoxView HeightRequest="1"
                             Color="#E8AE38" />

                    <!-- Quantity Selection -->
                    <Label Text="Select Quantity"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#8B302D"
                           HorizontalOptions="Center" />

                    <HorizontalStackLayout HorizontalOptions="Center"
                                           Spacing="25">

                        <Button Text="−"
                                Command="{Binding DecreaseQuantityCommand}"
                                BackgroundColor="#D98245"
                                TextColor="White"
                                FontSize="22"
                                WidthRequest="50"
                                CornerRadius="10" />

                        <Label Text="{Binding Quantity}"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#8B302D"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />

                        <Button Text="+"
                                Command="{Binding IncreaseQuantityCommand}"
                                BackgroundColor="#8B302D"
                                TextColor="White"
                                FontSize="22"
                                WidthRequest="50"
                                CornerRadius="10" />

                    </HorizontalStackLayout>

                    <!-- Add to Cart -->
                    <Button Text="🛒  Add to Cart"
                            Command="{Binding AddToCartCommand}"
                            BackgroundColor="#8B302D"
                            TextColor="#FFF9F0"
                            FontAttributes="Bold"
                            FontSize="16"
                            CornerRadius="12"
                            HeightRequest="52" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</views:BaseView>
