<?xml version="1.0" encoding="utf-8" ?>

<views:BaseView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ShoppingApp.Views"
    x:Class="ShoppingApp.Views.CheckoutView"
    Title="Checkout">

    <VerticalStackLayout
        Padding="25"
        Spacing="20"
        VerticalOptions="Center">

        <Label
            Text="Checkout"
            FontFamily="JainiRegular"
            FontSize="42"
            HorizontalOptions="Center"
            TextColor="#621B2D" />

        <Label
            Text="Please review your order before placing it."
            FontSize="16"
            HorizontalTextAlignment="Center" />

        <Label
            Text="{Binding CustomerDisplayName, StringFormat='Customer: {0}'}"
            FontSize="18"
            HorizontalTextAlignment="Center" />

        <Button
            Text="Place Order"
            Command="{Binding PlaceOrderCommand}"
            BackgroundColor="#621B2D"
            TextColor="White"
            CornerRadius="12"
            HeightRequest="50" />

    </VerticalStackLayout>

</views:BaseView>