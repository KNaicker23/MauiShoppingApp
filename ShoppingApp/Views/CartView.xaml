<?xml version="1.0" encoding="utf-8" ?>
<views:BaseView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ShoppingApp.Views"
    x:Class="ShoppingApp.Views.CartView"
    Title="My Cart">

    <Grid Padding="20"
          RowDefinitions="Auto,*,Auto"
          RowSpacing="15">

        <!-- Cart heading -->
        <VerticalStackLayout Grid.Row="0"
                             Spacing="5">
            <Label Text="My Shopping Cart"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#621B2D" />

            <Label Text="{Binding CustomerDisplayName}"
                   FontSize="15"
                   TextColor="Gray" />

            <Label Text="{Binding TotalItems,
                                  StringFormat='Total items: {0}'}"
                   FontSize="14" />
        </VerticalStackLayout>

        <!-- Cart products -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding CartItems}"
                        SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="10"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center">
                    <Label Text="Your cart is empty."
                           FontSize="20"
                           FontAttributes="Bold" />

                    <Label Text="Browse our catalogue and add some products!"
                           FontSize="14"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12"
                            Margin="0,5"
                            Stroke="#D6B8A8"
                            StrokeThickness="1">

                        <Grid ColumnDefinitions="100,*"
                              ColumnSpacing="12">

                            <Image Grid.Column="0"
                                   Source="{Binding ImageName}"
                                   HeightRequest="100"
                                   WidthRequest="100"
                                   Aspect="AspectFit" />

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="5">

                                <Label Text="{Binding ProductName}"
                                       FontSize="17"
                                       FontAttributes="Bold" />

                                <Label Text="{Binding ProductPrice,
                                                      StringFormat='Price: R{0:F2}'}"
                                       FontSize="14" />

                                <Label Text="{Binding Quantity,
                                                      StringFormat='Quantity: {0}'}"
                                       FontSize="14" />

                                <Label Text="{Binding LineTotal,
                                                      StringFormat='Subtotal: R{0:F2}'}"
                                       FontSize="15"
                                       TextColor="#621B2D"
                                       FontAttributes="Bold" />

                                <Button Text="Remove"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}},
                                                          Path=BindingContext.RemoveItemCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#A42B3D"
                                        TextColor="White"
                                        CornerRadius="8"
                                        HeightRequest="38"
                                        HorizontalOptions="Start" />

                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Cart total -->
        <VerticalStackLayout Grid.Row="2"
                             Spacing="10">

            <BoxView HeightRequest="1"
                     Color="#D6B8A8" />

            <Label Text="{Binding CartTotal,
                                  StringFormat='Cart Total: R{0:F2}'}"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#621B2D"
                   HorizontalOptions="End" />

            <Button Text="Proceed to Checkout"
                    BackgroundColor="#621B2D"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="50"
                    IsEnabled="False" />

        </VerticalStackLayout>

    </Grid>
</views:BaseView>