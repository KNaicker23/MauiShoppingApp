<?xml version="1.0" encoding="utf-8" ?>

<views:BaseView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ShoppingApp.Views"
    x:Class="ShoppingApp.Views.CartView"
    Title="My Cart"
    BackgroundColor="#F7E8CF">

    <Grid Padding="20"
          RowDefinitions="Auto,*,Auto"
          RowSpacing="15">

        
        <VerticalStackLayout Grid.Row="0"
                             Spacing="3">

            <Label Text="✦ Tadka ✦"
                   FontFamily="JainiRegular"
                   FontSize="42"
                   TextColor="#8B302D"
                   HorizontalOptions="Center" />

            <Label Text="My Shopping Cart"
                   FontSize="25"
                   FontAttributes="Bold"
                   TextColor="#8B302D"
                   HorizontalOptions="Center" />

            <Label Text="{Binding CustomerDisplayName}"
                   FontSize="14"
                   TextColor="#A65E3F"
                   HorizontalOptions="Center" />

            <Label Text="{Binding TotalItems,
                                  StringFormat='Total items: {0}'}"
                   FontSize="14"
                   TextColor="#655044"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding CartItems}"
                        SelectionMode="None"
                        BackgroundColor="Transparent">

            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="10"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center">

                    <Label Text="🛒"
                           FontSize="45"
                           HorizontalOptions="Center" />

                    <Label Text="Your cart is empty."
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#8B302D"
                           HorizontalOptions="Center" />

                    <Label Text="Browse our catalogue and add some products!"
                           FontSize="14"
                           TextColor="#655044"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border Padding="12"
                            Margin="0,6"
                            BackgroundColor="#FFF9F0"
                            Stroke="#D98245"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 15">

                        <Grid ColumnDefinitions="100,*"
                              ColumnSpacing="12">

                            <Border Grid.Column="0"
                                    BackgroundColor="#F7E8CF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="5"
                                    VerticalOptions="Center">

                                <Image Source="{Binding ImageName}"
                                       HeightRequest="95"
                                       WidthRequest="95"
                                       Aspect="AspectFit" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="6">

                                <Label Text="{Binding ProductName}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="#8B302D" />

                                <Label Text="{Binding ProductPrice,
                                                      StringFormat='Price: R{0:F2}'}"
                                       FontSize="13"
                                       TextColor="#655044" />

                                <Label Text="{Binding Quantity,
                                                      StringFormat='Quantity: {0}'}"
                                       FontSize="13"
                                       TextColor="#655044" />

                                <Label Text="{Binding LineTotal,
                                                      StringFormat='Subtotal: R{0:F2}'}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#8B302D" />

                                <Button Text="Remove"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}},
                                                          Path=BindingContext.RemoveItemCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#A65E3F"
                                        TextColor="White"
                                        CornerRadius="8"
                                        HeightRequest="36"
                                        HorizontalOptions="Start" />

                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

       
        <Border Grid.Row="2"
                BackgroundColor="#FFF9F0"
                Stroke="#D98245"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 15"
                Padding="15">

            <VerticalStackLayout Spacing="12">

                <BoxView HeightRequest="1"
                         Color="#E8AE38" />

                <Label Text="{Binding CartTotal,
                                      StringFormat='Cart Total: R{0:F2}'}"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#8B302D"
                       HorizontalOptions="End" />

                <Button Text="Proceed to Checkout  →"
                        Command="{Binding CheckoutCommand}"
                        BackgroundColor="#8B302D"
                        TextColor="#FFF9F0"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="50" />

            </VerticalStackLayout>
        </Border>

    </Grid>
</views:BaseView>