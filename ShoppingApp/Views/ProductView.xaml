<?xml version="1.0" encoding="utf-8" ?>

<views:BaseView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ShoppingApp.Views"
    x:Class="ShoppingApp.Views.ProductView"
    Title="Tadka Catalogue"
    BackgroundColor="#F7E8CF">

    <Grid Padding="20"
          RowDefinitions="Auto,Auto,Auto,Auto,*"
          RowSpacing="15">

        
        <VerticalStackLayout Grid.Row="0"
                             Spacing="2">

            <Label Text="✦ Tadka ✦"
                   FontFamily="JainiRegular"
                   FontSize="48"
                   TextColor="#8B302D"
                   HorizontalOptions="Center" />

            <Label Text="A taste of home, in every spice."
                   FontSize="13"
                   TextColor="#A65E3F"
                   HorizontalOptions="Center" />

        </VerticalStackLayout>

       
        <VerticalStackLayout Grid.Row="1"
                             Spacing="4">

            <Label
                Text="{Binding CustomerDisplayName}"
                FontSize="19"
                FontAttributes="Bold"
                TextColor="#8B302D"
                HorizontalOptions="Center" />

            <Label Text="Explore our spices and pantry essentials."
                   FontSize="14"
                   TextColor="#655044"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

        </VerticalStackLayout>

        
        <Button Grid.Row="2"
                Text="🛒  View My Cart"
                Command="{Binding OpenCartCommand}"
                BackgroundColor="#D98245"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="12"
                HeightRequest="48"
                HorizontalOptions="End" />
        
        <Label Grid.Row="3"
               Text="✦  Our Spice Collection  ✦"
               FontFamily="JainiRegular"
               FontSize="25"
               TextColor="#8B302D"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center" />

        
        <CollectionView Grid.Row="4"
                        ItemsSource="{Binding Products}"
                        SelectionMode="None"
                        BackgroundColor="Transparent">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border Padding="15"
                            Margin="0,7"
                            BackgroundColor="#FFF9F0"
                            Stroke="#D98245"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16">

                        <VerticalStackLayout Spacing="9">

                            
                            <Border BackgroundColor="#F7E8CF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="8">

                                <Image Source="{Binding ImageName}"
                                       HeightRequest="155"
                                       WidthRequest="155"
                                       Aspect="AspectFit"
                                       HorizontalOptions="Center" />
                                

                            </Border>


                            
                            <Label Text="{Binding ProductName}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#8B302D" />

                            
                            <Label Text="{Binding CategoryName}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#A65E3F" />

                            
                            <Label Text="{Binding ProductDescription}"
                                   FontSize="13"
                                   TextColor="#655044"
                                   LineBreakMode="WordWrap" />

                            
                            <Label Text="{Binding ProductPrice, StringFormat='R{0:F2}'}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#8B302D" />

                            
                            <Label Text="{Binding StockAvailable, StringFormat='Available stock: {0}'}"
                                   FontSize="13"
                                   TextColor="#65734A" />

                            
                            <Button Text="View Details  →"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}},
                                                      Path=BindingContext.OpenProductDetailsCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#8B302D"
                                    TextColor="#FFF9F0"
                                    FontAttributes="Bold"
                                    CornerRadius="10"
                                    HeightRequest="45" />

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</views:BaseView>
