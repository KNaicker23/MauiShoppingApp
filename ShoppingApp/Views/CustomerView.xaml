<?xml version="1.0" encoding="utf-8" ?>
<views:BaseView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:views="clr-namespace:ShoppingApp.Views"
                x:Class="ShoppingApp.Views.CustomerView"
                Title="Select Customer">

    <Grid Padding="20"
          RowDefinitions="Auto,Auto,*,Auto"
          RowSpacing="20">

        <Label Grid.Row="0"
               Text="Tadka"
               FontFamily="JainiRegular"
               FontSize="42"
               HorizontalOptions="Center" />

        <Label Grid.Row="1"
               Text="Please select a customer to continue."
               FontSize="16"
               HorizontalOptions="Center" />

        <CollectionView Grid.Row="2"
                ItemsSource="{Binding Customers}"
                SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                SelectionMode="Single">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="15"
                            Margin="0,5"
                            Stroke="#D6B8A8"
                            StrokeThickness="1">

                        <VerticalStackLayout Spacing="5">

                            <Label Text="{Binding CustomerName}"
                                   FontSize="18"
                                   FontAttributes="Bold" />

                            <Label Text="{Binding CustomerLastName}"
                                   FontSize="14" />

                            <Label Text="{Binding CustomerEmail}"
                                   FontSize="13"
                                   TextColor="Gray" />

                        </VerticalStackLayout>

                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
        <Button Grid.Row="3"
                Text="Continue"
                Command="{Binding ContinueCommand}"
                BackgroundColor="#621B2D"
                TextColor="White"
                CornerRadius="12"
                HeightRequest="50" />

    </Grid>

</views:BaseView>